# Ignore dependencies that are managed with Composer.
# We only want to commit our own stuff, that is unique to this project. So we do not
# commit the vendor directory, not even autoload.php and vendor/siel/acumulus. If you want
# to use this project from GitHub instead or via the WHMCS marketplace, you will have to
# run "composer update --no-dev" yourself.
composer.lock
/vendor/*

# Ignore some files we keep just for reference.
/config.json
src/*Old.php

# PHPStorm and PHPUnit
.idea/*
/tests/.phpunit.result.cache
# Our own tests are committed, but not the *.latest.* files
**/Data/**/*.latest.*
